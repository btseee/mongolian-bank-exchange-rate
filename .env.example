DATABASE_URL=sqlite:///./exchange_rates.db
CRON_SCHEDULE=0 9 * * *

# Admin endpoints (POST /api/admin/*) - empty disables them (503)
ADMIN_API_KEY=
BACKFILL_DELAY_SECONDS=2
LOG_LEVEL=INFO

# Keeps a Render free instance awake - empty disables it. Set to the app's
# own public URL, e.g. https://your-app.onrender.com/api/health
SELF_PING_URL=

SSL_VERIFY=true
REQUEST_TIMEOUT=30
PLAYWRIGHT_TIMEOUT=60000

ENABLE_PARALLEL=true
MAX_WORKERS=8
PLAYWRIGHT_MAX_WORKERS=3

API_MAX_LIMIT=100
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
TRUST_PROXY_HEADERS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000

# ArigBank only - optional, the crawler signs in fresh when this is unset
ARIGBANK_BEARER_TOKEN=

# All bank endpoint URLs (KHANBANK_URI, GOLOMT_URI, ...) already have
# working defaults in app/config.py. Only add one of those variables here
# if a bank changes its URL and you need to override it without a code change.
